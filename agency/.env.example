# --- Supabase (omit all three => app runs in local DEMO mode with a JSON-file store) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- AI providers (server-side only). Omit both => MOCK adapter (development only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
# anthropic | openai | mock  (default: first configured, else mock)
AI_PROVIDER=
# --- Worker ---
CRON_SECRET=change-me
